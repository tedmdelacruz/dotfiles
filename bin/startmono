#!/bin/bash

# Navigate to the project directory
cd ~/Code/erudifi/mono

# Create a new tmux session called 'mono'
tmux new-session -d -s mono

# Window 1: Docker compose setup with vertical split
tmux rename-window -t mono:1 'docker'
tmux split-window -t mono:1 -v
tmux resize-pane -t mono:1.1 -y  4
tmux send-keys -t mono:1.1 'docker compose down; docker compose up -d; docker compose logs -f backend worker' Enter

# Window 2: Claude
tmux new-window -t genai -n 'claude'
tmux send-keys -t mono:2 'claude' Enter

# Select Window 1 and attach to session
tmux select-window -t mono:1
tmux attach-session -t mono
